# Copy this file to .env.local. Never commit .env.local or paste keys into client code.
# These three credentials are required for live research. No NEXT_PUBLIC_ credentials.
GOOGLE_PLACES_API_KEY=
EXA_API_KEY=
OPENAI_API_KEY=

# Model and operational bounds. Source freshness is always requested per research run.
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=low
RESEARCH_TIMEOUT_MS=220000
PROVIDER_TIMEOUT_MS=25000
MODEL_TIMEOUT_MS=170000
